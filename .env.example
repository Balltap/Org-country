# ===================================================================
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องจริง
#     cp .env.example .env
# ห้าม commit ไฟล์ .env เข้า git
# ===================================================================

# ที่อยู่ของเว็บ
#   ใช้โดเมนจริง  → Caddy ขอใบรับรอง HTTPS ให้อัตโนมัติ (ต้องชี้ DNS มาที่เครื่องนี้ก่อน)
#   ใช้ :80       → HTTP ธรรมดา สำหรับทดสอบหรือใช้ในวง LAN เท่านั้น
SITE_ADDRESS=map.example.com

# บัญชีเข้าใช้งาน (Basic Auth)
# สร้าง hash ด้วยคำสั่ง:
#   docker run --rm caddy:2.8-alpine caddy hash-password --plaintext 'รหัสผ่านของคุณ'
# แล้วเอาผลลัพธ์ที่ขึ้นต้นด้วย $2a$ มาใส่ตรง BASIC_AUTH_HASH
# หมายเหตุ: ถ้า hash มีเครื่องหมาย $ ให้พิมพ์เป็น $$ ในไฟล์นี้
BASIC_AUTH_USER=countryside
BASIC_AUTH_HASH=

# การสำรองข้อมูลอัตโนมัติ
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=30

TZ=Asia/Bangkok
